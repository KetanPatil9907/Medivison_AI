# ============================================================
# MediVision AI - Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to version control.
# ============================================================

# ---------- App ----------
APP_NAME=MediVision AI
APP_ENV=development
APP_DEBUG=true
APP_VERSION=1.0.0
API_V1_PREFIX=/api/v1
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# ---------- Database (PostgreSQL) ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=medivision
POSTGRES_USER=medivision
POSTGRES_PASSWORD=medivision_dev_password
DATABASE_URL=postgresql+psycopg2://medivision:medivision_dev_password@localhost:5432/medivision

# ---------- Security ----------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_this_to_a_long_random_hex_string_at_least_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256
PASSWORD_MIN_LENGTH=8
JWT_ISSUER=medivision-ai
JWT_AUDIENCE=medivision-ai-client

# ---------- CORS ----------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------- Rate Limiting ----------
RATE_LIMIT_GENERAL=60/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_AI=20/minute
RATE_LIMIT_UPLOAD=6/minute

# ---------- MinIO / S3 Compatible Storage ----------
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=medivision
S3_SECRET_KEY=medivision_storage_secret
S3_BUCKET=medivision-storage
S3_PUBLIC_BASE_URL=http://localhost:9000/medivision-storage
STORAGE_DRIVER=s3

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ---------- Celery ----------
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ---------- AI / ML ----------
# LLM provider for the AI Health Chat Assistant.
LLM_PROVIDER=openai
LLM_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=30

# Vision model weights directory
VISION_MODEL_DIR=../ai/computer_vision

# Symptom model path
SYMPTOM_MODEL_PATH=../ai/symptom_model
SYMPTOM_RULE_BASED_FALLBACK=true

# Risk model path
RISK_MODEL_PATH=../ai/risk_models

# Vendor demo / fallback mode: if true, transparently uses
# rule-based demo mode when trained models are unavailable.
AI_FALLBACK_MODE=true

# ---------- Notifications ----------
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=MediVision AI <no-reply@medivision.example>
NOTIFICATION_EMAIL_ENABLED=false