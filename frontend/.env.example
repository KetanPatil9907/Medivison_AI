# Base URL of the backend API (all endpoints live under /api/v1)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Frontend public origin (used for links/redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000